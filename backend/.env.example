# ==============================================================================
# STUDENT PERFORMANCE PREDICTION SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Purpose of File: Template environment file for backend system settings,
#                   database credentials, server host configuration, and CORS parameters.
#
# Usage Instructions:
# 1. Copy this file to '.env' in the backend folder:
#    cp .env.example .env
# 2. Update the credentials below to match your local environment configuration.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Environment & Debug
# ------------------------------------------------------------------------------
PROJECT_NAME="Student Performance Prediction API"
ENVIRONMENT="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000
SECRET_KEY="SUPER_SECRET_KEY_STUDENT_PERFORMANCE_PREDICTION_2026_FINAL_YEAR_PROJECT"

# ------------------------------------------------------------------------------
# 2. Database Connection Credentials
# ------------------------------------------------------------------------------
# Uncomment and configure PostgreSQL settings if running with PostgreSQL database:
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_secure_password_here"
POSTGRES_SERVER="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="student_performance_db"

# Optional: Direct Database Connection URI (Overrides individual Postgres variables if set)
# DATABASE_URL="postgresql://postgres:your_secure_password_here@localhost:5432/student_performance_db"
# If DATABASE_URL is left empty or commented out, the app defaults to local SQLite database.

# ------------------------------------------------------------------------------
# 3. Security & CORS Allowed Origins (Comma-Separated)
# ------------------------------------------------------------------------------
# CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# 4. File Upload Constraints
# ------------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10
